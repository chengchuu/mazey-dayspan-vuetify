{
  "name": "mazey-dayspan-vuetify",
  "version": "3.2.2",
  "description": "A modern Vue 3 and Vuetify calendar and scheduling component library inspired by DaySpan Vuetify.",
  "author": "Cheng",
  "keywords": [
    "vue",
    "vue3",
    "vuetify",
    "vuetify3",
    "calendar",
    "scheduler",
    "scheduling",
    "events",
    "recurrence",
    "typescript",
    "component-library"
  ],
  "license": "MIT",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/chengchuu/mazey-dayspan-vuetify.git"
  },
  "homepage": "https://chengchuu.github.io/mazey-dayspan-vuetify/",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "docs:dev": "vite --config playground/vite.config.ts",
    "docs:build": "npm run docs:links && vite build --config playground/vite.config.ts",
    "docs:links": "node scripts/validate-doc-links.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vuetify": "^3.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "jsdom": "^26.1.0",
    "sass": "^1.89.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.0",
    "vue-tsc": "3.3.7",
    "vuetify": "^3.12.0"
  },
  "dependencies": {
    "mazey": "^5.6.0"
  }
}
